{
  "name": "blindspot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Blindspot — expose what a robot cannot see. Hackathon prototype frontend/runtime workspace.",
  "scripts": {
    "dev": "vite --config src/runtime/vite.config.ts",
    "dev:ui": "vite --mode ui --open /ui.html",
    "dev:engine": "vite --mode engine --open /engine.html",
    "build": "vite build",
    "build:ui": "vite build --mode ui",
    "build:public": "vite build --mode public",
    "build:engine": "vite build --mode engine",
    "preview": "vite preview",
    "preview:ui": "vite preview --mode ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@react-three/fiber": "9.7.0",
    "@sparkjsdev/spark": "2.1.0",
    "convex": "1.45.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
